<?xml version="1.0" encoding="utf-8"?>
<!-- 一檔：左區、右區（各自由程式逐項加入，可多行） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_row"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/w_rl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" />
    <LinearLayout android:id="@+id/w_rr" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:gravity="end" android:orientation="vertical" />
</LinearLayout>
