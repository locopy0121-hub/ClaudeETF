<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小工具：背景圖層＋內容；樣式（主題、透明度、圓角、字級、內容與列數）由 App 內「桌面小工具」設定控制 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_24" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="總資產（TWD）" android:textColor="#9AA3B2" android:textSize="12sp" />

        <TextView android:id="@+id/w_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:text="—" android:textColor="#E8ECF2" android:textSize="24sp" android:textStyle="bold" />

        <TextView android:id="@+id/w_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:text="" android:textColor="#9AA3B2" android:textSize="13sp" />

        <TextView android:id="@+id/w_index" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="2"
            android:text="" android:textColor="#9AA3B2" android:textSize="11sp" />

        <FrameLayout android:id="@+id/w_div" android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="2dp" android:background="#33FFFFFF" />

        <LinearLayout android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="" android:textColor="#9AA3B2" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
