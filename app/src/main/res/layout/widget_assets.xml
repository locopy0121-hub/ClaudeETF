<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="總資產（TWD）"
        android:textColor="#9AA3B2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="—"
        android:textColor="#E8ECF2"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="今日 —"
        android:textColor="#9AA3B2"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:background="#33FFFFFF" />

    <LinearLayout
        android:id="@+id/w_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_p1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_s2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_p2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_s3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_p3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_s4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_p4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_s5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E8ECF2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_p5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#9AA3B2"
        android:textSize="11sp" />
</LinearLayout>
