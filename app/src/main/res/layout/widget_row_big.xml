<?xml version="1.0" encoding="utf-8"?>
<!-- 大字條列：上排名稱＋大字價格，下排附加資訊＋漲跌 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_bn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:textColor="#E8ECF2" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_bp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:maxLines="1" android:textColor="#E8ECF2" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_bx" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:textColor="#9AA3B2" android:textSize="11sp" />
        <TextView android:id="@+id/w_bc" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:maxLines="1" android:textColor="#9AA3B2" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
